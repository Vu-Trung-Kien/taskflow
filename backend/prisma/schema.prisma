generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  OWNER
  MEMBER
  VIEWER

  @@map("project_role")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

// Email addresses are canonicalized to lowercase by the application before persistence.
// This keeps the existing unique constraint and avoids requiring a PostgreSQL extension.
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships     ProjectMember[]
  createdProjects Project[]       @relation("ProjectCreator")
  assignedTasks   Task[]          @relation("TaskAssignee")
  createdTasks    Task[]          @relation("TaskCreator")
  comments       TaskComment[]
  attachments    Attachment[]
  authSessions   AuthSession[]

  @@map("users")
}

model Project {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(120)
  description String?   @db.Text
  createdById String    @map("created_by_id") @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members ProjectMember[]
  tasks   Task[]

  @@index([createdById])
  @@index([archivedAt])
  @@map("projects")
}

model ProjectMember {
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now()) @map("joined_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
  @@map("project_members")
}

model Task {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String       @map("project_id") @db.Uuid
  parentTaskId String?      @map("parent_task_id") @db.Uuid
  assigneeId   String?      @map("assignee_id") @db.Uuid
  createdById  String       @map("created_by_id") @db.Uuid
  title        String       @db.VarChar(200)
  description  String?      @db.Text
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueAt        DateTime?    @map("due_at") @db.Timestamptz(3)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  project    Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  parentTask Task?   @relation("TaskHierarchy", fields: [projectId, parentTaskId], references: [projectId, id], onDelete: Restrict)
  subTasks   Task[]  @relation("TaskHierarchy")
  comments   TaskComment[]
  attachments Attachment[]
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy  User    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, id])
  @@index([projectId, status, deletedAt])
  @@index([projectId, dueAt])
  @@index([assigneeId, status])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.VarChar(5000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  task   Task @relation(fields: [projectId, taskId], references: [projectId, id], onDelete: Restrict)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId, taskId, createdAt])
  @@map("task_comments")
}

model Attachment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  taskId       String    @map("task_id") @db.Uuid
  uploadedById String    @map("uploaded_by_id") @db.Uuid
  objectKey    String    @unique @map("object_key") @db.VarChar(512)
  fileName     String    @map("file_name") @db.VarChar(255)
  contentType  String    @map("content_type") @db.VarChar(128)
  sizeBytes    Int       @map("size_bytes")
  uploadedAt   DateTime? @map("uploaded_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  task       Task @relation(fields: [projectId, taskId], references: [projectId, id], onDelete: Restrict)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([projectId, taskId, createdAt])
  @@map("attachments")
}

model AuthSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, revokedAt])
  @@map("refresh_tokens")
}
